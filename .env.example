# העתק קובץ זה ל-.env להרצה מקומית, או השתמש ב-"fly secrets set" בפרודקשן.

# הסיסמה המשותפת לכניסת המפקדים
APP_PASSWORD=בחר-סיסמה-חזקה-כאן

# מפתח סודי לחתימת עוגיות ההתחברות. צור מחרוזת אקראית ארוכה, למשל:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=מחרוזת-אקראית-ארוכה-מאוד

# פורט (רשות)
# PORT=3000

# מיקום קובץ בסיס הנתונים (רשות)
# DB_PATH=./data.db
