# העתק קובץ זה ל-.env להרצה מקומית, או הגדר את הערכים בממשק של Render.

# כתובת בסיס הנתונים (PostgreSQL). בפרודקשן זו הכתובת מ-Neon, למשל:
#   postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/mahlaka

# הסיסמה המשותפת לכניסת המפקדים
APP_PASSWORD=בחר-סיסמה-חזקה-כאן

# מפתח סודי לחתימת עוגיות ההתחברות. צור מחרוזת אקראית ארוכה, למשל:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=מחרוזת-אקראית-ארוכה-מאוד

# פורט (רשות)
# PORT=3000
